# Copy to .env and edit. Never commit .env.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Kathmandu

# Database: "postgresql" (default), "mysql", or "sqlite" for a quick local run
DB_ENGINE=postgresql
DB_NAME=smart_classroom
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# Computer-vision pipeline
CV_DEVICE=cpu                 # cpu or cuda
CV_VIDEO_SOURCE=0             # webcam index, or path to a video file
CV_RECOGNITION_THRESHOLD=0.35 # cosine similarity required to accept an identity
CV_MODEL_DIR=cv_pipeline/models
# Optional JSON with validated indicator thresholds and neutral camera angles.
# CV_CALIBRATION_FILE=data/calibration.json
